# Copy this file to .env and fill in your values.
# Backend environment variables.

# Supabase PostgreSQL connection string (transaction pooler).
# Get it from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> Pooler.
# Use the "postgresql://postgres.<ref>:<password>@...pooler.supabase.com:6543/postgres" (transaction mode, port 6543).
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?sslmode=require
LOG_LEVEL=INFO
UPLOAD_DIR=./app/uploads

# Supabase project configuration
# URL: Supabase Dashboard -> Project Settings -> API -> Project URL  (e.g. https://xxxxx.supabase.co)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Project API keys -> anon public key (safe to expose to the browser)
SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Project API keys -> service_role key (SECRET - backend only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Project Settings -> API -> JWT Secret (used to verify Supabase access tokens)
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET

# Frontend base URL
FRONTEND_URL=http://localhost:5173
