# Copy this file to .env and fill in your values.
# Frontend environment variables (Vite exposes only VITE_* vars to the browser).

# Supabase project URL + anon (public) key from: Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=REPLACE_WITH_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY

# Your FastAPI backend URL (local dev default)
VITE_API_BASE_URL=http://localhost:8000
